# Copy to .env and fill in. NEVER commit .env
PORT=3000

# Long random strings. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
MESSAGE_KEY=change-me-too

# ---- Sumit AI (optional). Pick ONE option and fill it in. ----
# Option A (free): any OpenAI-compatible provider. Examples:
#   Google Gemini : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.5-flash
#   Groq          : AI_BASE_URL=https://api.groq.com/openai/v1                           AI_MODEL=openai/gpt-oss-120b
#   OpenRouter    : AI_BASE_URL=https://openrouter.ai/api/v1                              AI_MODEL=<a model ending in :free>
#   Ollama (local): AI_BASE_URL=http://localhost:11434/v1   AI_API_KEY=ollama             AI_MODEL=llama3.2
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Option B (paid): Anthropic API
ANTHROPIC_API_KEY=

# Hosting on a free server? Set DEMO_SEED=true to recreate demo accounts (asha / rohan / meera, password demo1234) whenever the database is empty.
DEMO_SEED=false

# Set to true only when served over HTTPS (production)
COOKIE_SECURE=false
